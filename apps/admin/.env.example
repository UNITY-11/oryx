# WhatsApp Cloud API — same keys as web app (admin sends confirmations on booking status change)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_NEW_BOOKING=new_booking_alert
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=booking_confirmed
WHATSAPP_TEMPLATE_INVOICE=invoice_message

# Admin session signing secret (required in production)
ADMIN_SESSION_SECRET=

# Optional: public admin URL for password-reset links (defaults to request origin)
# NEXT_PUBLIC_ADMIN_URL=https://admin.yourdomain.com

# SMTP for forgot-password emails (e.g. Gmail app password for oryxbeauty.qa@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

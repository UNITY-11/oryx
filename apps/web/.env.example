# WhatsApp Cloud API (Meta) — required for automated booking messages
# Get these from https://developers.facebook.com/ → Your App → WhatsApp → API Setup

# Permanent access token from Meta Business
WHATSAPP_API_TOKEN=

# Phone Number ID (Meta ID for your business sender number — NOT the admin's personal number)
WHATSAPP_PHONE_NUMBER_ID=

# Optional
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en

# Approved Meta message templates (must use a single body variable {{1}})
WHATSAPP_TEMPLATE_NEW_BOOKING=new_booking_alert
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=booking_confirmed
WHATSAPP_TEMPLATE_INVOICE=invoice_message

# Set to false to disable all WhatsApp sends without removing keys
# WHATSAPP_ENABLED=false

# Fallback admin recipient if Company → WhatsApp is empty
# ADMIN_WHATSAPP_FALLBACK=974XXXXXXXX
